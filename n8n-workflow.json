      "parameters": {
        "html_content": "=<div style=\"width: 480px; padding: 35px; background: #ffffff; border: 2px solid #e2e8f0; border-radius: 20px; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #0f172a; position: relative; line-height: 1.6;\">\n    \n    <!-- Top Right: Issued Date -->\n    <div style=\"position: absolute; top: 20px; right: 25px; font-size: 11px; color: #64748b; text-align: right; line-height: 1.2;\">\n        Receipt Issued On:<br>\n        <span style=\"font-weight: 700; color: #1e293b;\">{{ new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) }}</span>\n    </div>\n\n    <!-- Official Header -->\n    <div style=\"text-align: left; border-bottom: 3px solid #f1f5f9; padding-bottom: 20px; margin-bottom: 25px;\">\n        <div style=\"font-size: 26px; font-weight: 800; color: #1e40af; letter-spacing: -0.5px; margin-bottom: 4px;\">AL-KHIDMAT FOUNDATION</div>\n        <div style=\"font-size: 12px; color: #475569; font-weight: 600; text-transform: uppercase; letter-spacing: 2px;\">Donation Receipt</div>\n    </div>\n\n    <!-- Main Content -->\n    <div style=\"margin-bottom: 30px;\">\n        <p style=\"font-size: 16px; color: #334155; margin: 0;\">\n            JazakAllah Khair! We gratefully acknowledge your contribution for <b style=\"color: #0f172a;\">{{ $node[\"Classify Donation Category\"].json.content.parts[0].text }}</b>, which has been successfully verified.\n        </p>\n    </div>\n\n    <!-- Details Table -->\n    <div style=\"background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;\">\n        <div style=\"display: flex; justify-content: space-between; margin-bottom: 12px; border-bottom: 1px dashed #cbd5e1; padding-bottom: 8px;\">\n            <span style=\"color: #475569; font-size: 12px; font-weight: 600;\">VOUCHER NO:</span>\n            <span style=\"font-weight: 800; font-size: 12px; color: #1e293b;\">AKF-{{ Math.floor(Math.random() * 90000) + 10000 }}</span>\n        </div>\n        \n        <div style=\"display: flex; justify-content: space-between; margin-bottom: 12px;\">\n            <span style=\"color: #475569; font-size: 14px; font-weight: 500;\">Payment Channel:</span>\n            <span style=\"font-weight: 700; font-size: 14px; color: #0f172a;\">{{ $node[\"Fetch Pending Donation\"].json.bank_name }}</span>\n        </div>\n        \n        <div style=\"display: flex; justify-content: space-between; margin-bottom: 12px;\">\n            <span style=\"color: #475569; font-size: 14px; font-weight: 500;\">Reference ID:</span>\n            <span style=\"font-weight: 700; font-size: 14px; color: #0f172a;\">#{{ $node[\"Fetch Pending Donation\"].json.transaction_ref }}</span>\n        </div>\n        \n        <div style=\"display: flex; justify-content: space-between; margin-bottom: 12px;\">\n            <span style=\"color: #475569; font-size: 14px; font-weight: 500;\">Donation Date:</span>\n            <span style=\"font-weight: 700; font-size: 14px; color: #0f172a;\">\n                {{ $node[\"Fetch Pending Donation\"].json.transaction_time ? new Date($node[\"Fetch Pending Donation\"].json.transaction_time).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Verified' }}\n            </span>\n        </div>\n\n        <div style=\"margin-top: 15px; padding-top: 15px; border-top: 3px solid #1e40af; display: flex; justify-content: space-between; align-items: center;\">\n            <span style=\"color: #0f172a; font-weight: 800; font-size: 16px;\">AMOUNT RECEIVED</span>\n            <span style=\"color: #1e40af; font-weight: 900; font-size: 24px;\">PKR {{ $node[\"Fetch Pending Donation\"].json.amount }}</span>\n        </div>\n    </div>\n\n    <!-- Footer Text -->\n    <div style=\"margin-top: 30px; text-align: center; border-top: 1px solid #f1f5f9; padding-top: 20px;\">\n        <p style=\"font-size: 12px; color: #64748b; margin-bottom: 15px; font-style: italic;\">\n            This receipt is automatically generated upon verification.\n        </p>\n        <div style=\"display: inline-flex; align-items: center; padding: 6px 16px; background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; border-radius: 30px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;\">\n            Verified by Amanat AI\n        </div>\n    </div>\n</div>",
